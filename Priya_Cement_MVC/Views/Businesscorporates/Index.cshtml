@{
    ViewData["Title"] = "Company Information";
}

@section Styles {
      <link rel="stylesheet" href="~/Assets/css/center-mode-slider.css">
      <link rel="stylesheet" href="~/Assets/css/blogs-cards-slider.css">
      <link rel="stylesheet" href="Assets/css/thumb-slider.css" />
      <link rel="stylesheet" href="Assets/css/business-corporates.css" />
}

      <!-- HERO BANNER END-->
      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="Assets/images/banners/company-info-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="Assets/images/banners/company-info-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="Assets/images/banners/company-info-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-5xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 Business & Corporates
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                           Nekta —
                           <span class="innerbanner-title-span">
                              Business & Corporates
                           </span>
                        </h1>

                     </div>
                  </div>
               </div>
           

         </div>
      </section>
      <!-- HERO BANNER END -->

      <!-- ==================== INTR0- DELIVERING EXPERIENCES ==================== -->
         <section class="bc-experience-section relative section-spacing overflow-hidden page-intro-section">
            <!-- Decorative sushi platter on far right -->
            <img loading="lazy" src="Assets/images/business/icon-right.svg" alt=""
               class="bc-deco hidden xl:block w-40 -right-0 top-1/4" aria-hidden="true" />
            <div class="container relative z-10">
               <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                  <!-- Left: plate in circle -->
                  <div class="relative">
                     <div class="bc-plate-wrap">
                        <img loading="lazy" src="Assets/images/business/plate-circle.png" alt="Signature Nekta plate"
                           class="bc-plate-img" />
                        <img loading="lazy" src="Assets/images/business/coriander.svg" alt=""
                           class="bc-plate-mini" aria-hidden="true" />
                     </div>
                  </div>
                  <!-- Right: copy -->
                  <div class="relative space-y-6 md:space-y-8 sm:max-w-[35vw]">
                     <div class="section-title-outer mx-auto max-w-5xl">
                        <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                           Delivering Experiences <span class="text-letters-slide"> that Matter</span>
                        </h2>
                        
                     </div>
                    <div class="intro-outer-wrapper sm:pl-15">
                     <p>From daily cafeteria operations to exclusive boardroom dining, executive offsites and curated events, Nekta understands performance excellence at the highest level. Its relationships with global brands also highlight its compliance with stringent international standards, including security, quality, and employee satisfaction metrics that bring a blend of operational excellence and elevated dining experiences that redefine institutional catering in India.</p>
                     <div class="flex justify-start mt-5">
                           <a href="#" class="common-btn flex items-center gap-2 btn-slide-fill">
                           <span>Get in Touch</span>
                           <img loading="lazy" src="Assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                           </a>
                        </div>
                     </div>
                     <!-- Decorative leaf bottom-right -->
                  <img loading="lazy" src="Assets/images/intro-leaf/green_leaf_travel.svg" alt="" class="bc-leaf-deco absolute -bottom-6 right-0 md:right-4 w-10 md:w-12" aria-hidden="true" />

                  </div>
               </div>
            </div>
         </section>

         <!-- ==================== CORPORATE DINING EXCELLENCE ==================== -->
         <section class="bc-dining-section section-pb curveshape-wrap">
               <div class="curveSvg-bg">
                  <svg class="curveSvg" viewBox="0 0 1000 400" preserveAspectRatio="none" overflow="visible">
                     <path class="curvePath" data-max-curve="140"
                           d="M0,144 L1000,144 L1000,400 L0,400 Z" fill="#e8e0c4"></path>
                  </svg>
               </div>
               <!-- Tilted polaroids -->
               <div class="outer-polaroids-icons">
                  <div class="outer-polaroids">
                     <img loading="lazy" src="Assets/images/business/icon-2.webp" alt="" class="bc-deco bc-dining-deco--chili" aria-hidden="true" />
                     <div class="bc-polaroid bc-polaroid--left">
                     
                        <img loading="lazy" src="Assets/images/business/polaroid-left.jpg" alt="Corporate lunch meeting" />
                     </div>
                  </div>
                  <div class="bc-polaroid bc-polaroid--right">
                     <img loading="lazy" src="Assets/images/business/polaroid-right.jpg" alt="Team dining together" />
                  </div>
            
                  
                  <img loading="lazy" src="Assets/images/business/icon-1.webp" alt="" class="bc-deco bc-dining-deco--basil" aria-hidden="true" />
               </div>


               <div class="container relative z-10">
                  <!-- Section Heading -->
                        <div class="section-title-outer text-center max-w-6xl mx-auto">
                           <h2 class="title-section text text-h2" data-leaf-target letters-slide-down text-split>Corporate Dining <span class="text-letters-slide">Excellence</span>
                           </h2>
                           
                        </div>

                  <div class="max-w-3xl mx-auto text-center">
                        <p>
                           Corporate dining is where Nekta sets the standard. We
                           operate at scale with precision&mdash;delivering
                           consistent quality, reliability, safety and service
                           excellence across geographies, even in the most
                           demanding environments.
                        </p>
                        <p>
                           But our proposition goes beyond food. At Nekta, we
                           curate integrated dining experiences that enhance the
                           workplace&mdash;where every meal is thoughtfully
                           designed to delight consumers, elevate satisfaction,
                           and reflect the premium standards of modern
                           institutional catering.
                        </p>
                        <p>
                           With a deep understanding of high-volume operations
                           and evolving expectations, we partner with leading
                           organisations to design, manage, and continuously
                           refine dining programmes that consistently deliver on
                           quality, experience, and trust.
                        </p>
                  </div>
               </div>
         </section>

         <!-- ==================== LIFE IS A BEAUTIFUL PLATE (GALLERY) ==================== -->
         <section class="bg-green center-slider relative section-spacing overflow-hidden">
            <div class="container">
               <div class="relative z-10">
                     <div class="section-title-outer text-center max-w-6xl mx-auto section-title--light-outer">
                           <h2 class="section-title section-title--light" data-leaf-target letters-slide-down text-split>
                              Life is a <span class="section-title--dark text-letters-slide"> beautiful plate.</span>
                           </h2>
                     </div>
                    
                   <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-stretch thumb-slider-outer">
                        <div class="merge-imgs">
                           <img class="merge-img merge-img--cup" src="Assets/images/business/cup.webp" alt="" loading="lazy" />
                           <img class="merge-img merge-img--beans" src="Assets/images/business/coffee-beans.webp" alt="" loading="lazy" />
                        </div>

                        <!-- Main image -->
                        <div class="bc-life-frame bc-life-main thumb-slider-main">
                           <img id="lifeMainImage" src="Assets/images/business/Frame1.webp"
                              alt="Cafeteria management in action" loading="lazy" />
                        </div>

                        <!-- Thumbs + copy -->
                        <div class="flex flex-col gap-8 justify-start thumb-slider-thumbs">
                           <div class="grid grid-cols-4 gap-3 md:gap-4 thumb-grid-wrapper" id="lifeThumbWrapper">
                              <button type="button" class="thumb-arrow thumb-arrow--prev" id="thumbPrev" aria-label="Previous">‹</button>

                              <div class="thumb-track" id="lifeThumbTrack">
                                 <button type="button" class="bc-life-thumb is-active" style="display:none;"
                                    data-frame-index="1"
                                    data-life-image="Assets/images/business/Frame1.webp"
                                    aria-label="View Cafeteria Management">
                                    <img loading="lazy" src="Assets/images/business/Frame1.webp" alt="" />
                                 </button>
                                 <button type="button" class="bc-life-thumb"
                                    data-frame-index="2"
                                    data-life-image="Assets/images/business/Frame2.webp"
                                    aria-label="View gallery image 2">
                                    <img loading="lazy" src="Assets/images/business/Frame2.webp" alt="" />
                                 </button>
                                 <button type="button" class="bc-life-thumb"
                                    data-frame-index="3"
                                    data-life-image="Assets/images/business/Frame3.webp"
                                    aria-label="View gallery image 3">
                                    <img loading="lazy" src="Assets/images/business/Frame3.webp" alt="" />
                                 </button>
                                 <button type="button" class="bc-life-thumb"
                                    data-frame-index="4"
                                    data-life-image="Assets/images/business/Frame4.webp"
                                    aria-label="View gallery image 4">
                                    <img loading="lazy" src="Assets/images/business/Frame4.webp" alt="" />
                                 </button>
                                 <button type="button" class="bc-life-thumb"
                                    data-frame-index="5"
                                    data-life-image="Assets/images/business/Frame5.webp"
                                    aria-label="View gallery image 5">
                                    <img loading="lazy" src="Assets/images/business/Frame5.webp" alt="" />
                                 </button>
                              </div>

                              <button type="button" class="thumb-arrow thumb-arrow--next" id="thumbNext" aria-label="Next">›</button>
                           </div>

                           <div class="bc-life-copy sm:mt-5" id="lifeCopyBox">
                              <div class="read-more-wrapper" id="lifeCopyWrapper">
                                 <!-- active frame's heading + content gets injected here -->
                              </div>
                              <div class="link-md link-light mt-5 read-more-toggle cursor-pointer">
                                 <span class="underline read-more-text">Read More</span>
                                 <img loading="lazy" src="Assets/images/plus-icon.svg" alt="plus" class="max-w-auto read-more-icon" />
                              </div>
                           </div>

                           <!-- Hidden per-frame content templates. Edit heading + text here per frame. -->
                           <template id="frameContent-1">
                              <h3>Cafeteria Management</h3>
                              <div class="read-more-content" data-lines="12">
                                 <p>Nekta delivers end-to-end cafeteria management with a focus on scale, consistency, and a distinctly premium experience. We take complete operational ownership&mdash;from manpower deployment and procurement to service delivery&mdash;ensuring seamless, efficient, and high-quality operations across every location.</p>
                                 <p>Our approach goes beyond serving meals. We curate thoughtfully engineered menus that blend local preferences with global cuisines, offering diversity and relevance to today&rsquo;s consumers.</p>
                                    <p>Our approach goes beyond serving meals. We curate thoughtfully engineered menus that blend local preferences with global cuisines, offering diversity and relevance to today&rsquo;s consumers.</p>
                              </div>
                           </template>
                           <template id="frameContent-2">
                              <h3>Bakery &amp; Confectionery</h3>
                              <div class="read-more-content" data-lines="12">
                                 <p>Our specialised bakery and confectionery expertise, powered by TajSATS&rsquo; culinary heritage, brings artisanal quality, innovation, and indulgence into everyday dining.</p>
                                 <p>Our specialised bakery and confectionery expertise, powered by TajSATS&rsquo; culinary heritage, brings artisanal quality, innovation, and indulgence into everyday dining.</p>
                              </div>
                           </template>
                           <template id="frameContent-3">
                              <h3>Menu Curation</h3>
                              <div class="read-more-content" data-lines="12">
                                 <p>We curate thoughtfully engineered menus that blend local preferences with global cuisines, offering diversity and relevance to today&rsquo;s consumers.</p>
                                 <p>We curate thoughtfully engineered menus that blend local preferences with global cuisines, offering diversity and relevance to today&rsquo;s consumers.</p>
                              </div>
                           </template>
                           <template id="frameContent-4">
                              <h3>Operational Ownership</h3>
                              <div class="read-more-content" data-lines="12">
                                 <p>We take complete operational ownership&mdash;from manpower deployment and procurement to service delivery&mdash;ensuring seamless, high-quality operations across every location.</p>
                                 <p>We take complete operational ownership&mdash;from manpower deployment and procurement to service delivery&mdash;ensuring seamless, high-quality operations across every location.</p>
                              </div>
                           </template>
                           <template id="frameContent-5">
                              <h3>Culinary Heritage</h3>
                              <div class="read-more-content" data-lines="12">
                                 <p>TajSATS&rsquo; culinary heritage brings innovation and indulgence into everyday dining across every location we serve.</p>
                                 <p>TajSATS&rsquo; culinary heritage brings innovation and indulgence into everyday dining across every location we serve.</p>
                              </div>
                           </template>
                        </div>
                     </div>
               </div>
            </div>
         </section>

         <!-- ==================== NEKTA'S EDGE ==================== -->
         <section class="bc-edge-section section-pt">
            <img loading="lazy" src="Assets/images/business/coffe-img.svg" alt=""
               class="bc-deco hidden xl:block -left-0 top-30" aria-hidden="true" />
            <img loading="lazy" src="Assets/images/business/sushi-img.webp" alt=""
               class="bc-deco hidden xl:block -right-0 top-4" aria-hidden="true" />
            <div class="container relative z-10 ">
                <div class="section-title-outer text-center max-w-6xl mx-auto">
