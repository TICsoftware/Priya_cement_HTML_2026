
@{
    ViewData["Title"] = "Priya Cement";
    Layout = "~/Views/Shared/_Layout_home_page.cshtml";
}

@section head {
    <title></title>

    <script nonce="@(Context.Items["CSPNonce"])">document.documentElement.classList.add('site-preloader-pending');</script>
    <style nonce="@(Context.Items["CSPNonce"])">
      html.site-preloader-pending .site-header {
        opacity:0 !important;
        visibility:hidden !important;
        pointer-events:none !important;
      }
    </style>

    <meta content="" name="keywords" />
    <meta content="" name="description" />


    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="" />
    <meta name="twitter:title" content="" />
    <meta name="twitter:description" content="" />
    

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Nekta" />
    <meta property="og:title" content="" />
    <meta property="og:description" content="" />
    <meta property="og:url" content="" />
    <meta property="og:image" content="" />

    <meta itemprop="name" content="Nekta" />
    <meta itemprop="description" content="" />
    <meta itemprop="image" content="" />

    <!-- Facebook / Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nekta" />
    <meta property="og:title" content="" />
    <meta property="og:description" content="" />
    <meta property="og:image" content="" />
    <meta property="og:url" content="" />

    <link rel="canonical" href="" />
}

@section Styles {

    <link rel="preload" href="~/Assets/css/swiper-bundle.min.css" as="style">
    <link rel="stylesheet" href="~/Assets/css/swiper-bundle.min.css" />

    <link rel="preload" href="~/Assets/css/homepage-style.css" as="style">
    <link rel="stylesheet" href="~/Assets/css/homepage-style.css" />

    <link rel="preload" href="~/Assets/css/homepage-preloader.css" as="style" asp-append-version="true">
    <link rel="stylesheet" href="~/Assets/css/homepage-preloader.css" asp-append-version="true" />
}

<section class="hero-banner-section">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">

      <!-- Slide 1 -->
      <div class="swiper-slide">
        <div class="slide-media">
          <picture class="bannerinner-picture">
              <source media="(min-width:768px)" srcset="Assets/images/banners/homebanner-desktop-1.webp">
              <source media="(max-width:767px)" srcset="Assets/images/banners/homebanner-mobile-1.webp">
              <img class="slide-bg" src="Assets/images/banners/homebanner-desktop-1.webp" alt="" fetchpriority="high">
          </picture>
        </div>

        <div class="slide-scrim"></div>
        
