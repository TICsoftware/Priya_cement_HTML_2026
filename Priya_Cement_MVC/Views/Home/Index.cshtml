<section class="home-sustainability-section section-spacing overflow-hidden relative">
  <div class="video-bg-wrap absolute top-0 inset-s-0 w-full h-full overflow-hidden">
    <video
      class="video-bg w-full h-full object-fit-cover"
      autoplay
      muted
      loop
      playsinline
      poster="Assets/images/video/sustainability-poster.webp">
      <source src="Assets/images/video/home-sustainability-video.mp4" type="video/mp4">
    </video>
    <div class="video-bg-overlay absolute top-0 inset-s-0 w-full h-full"></div>
  </div>

  <div class="container relative z-1">
    <div class="section-title-outer section-title-outer-start section-title-sm white-copy">
      <h2 class="eyebrow-text">sustainability</h2>
      <h3 class="text-h2 title-section reveal-text">
       Strong cement, Lighter footprint
      </h3>
      <p>
       Building responsibly has always been part of how we build.
      </p>

      
    </div>
    <div class="sustainability-block divide-y divide-white/40 space-y-4 md:space-y-8">
        <div class="pb-4 md:pb-5 lg:pb-6 counter-wrap-outer">
          <div class="flex items-end gap-2 counter-wrap-inner">
            <div class="counter-wrap flex items-center gap-2">
              <span class="text-white counter" data-target="35" data-suffix="%">0</span>
            </div>
            <p class="stat-label">fly ash incorporated</p>
          </div>
          <p class="stat-sub">PPC puts industrial fly ash to work.</p>
        </div>
        <div class="pb-4 md:pb-5 lg:pb-6 counter-wrap-outer">
          <div class="flex items-end gap-2 counter-wrap-inner">
            <div class="counter-wrap flex items-center gap-2">
              <p class="text-white counter" data-target="11" data-suffix="MW">0</p>
            </div>
            <span class="stat-label">waste heat recovered</span>
          </div>
          <p class="stat-sub">Process heat converted into clean electricity.</p>
        </div>
        <div class="pb-4 md:pb-5 lg:pb-6 counter-wrap-outer">
          <div class="flex items-end gap-2 counter-wrap-inner">
            <div class="counter-wrap flex items-center gap-2">
              <span class="text-white counter-no">GreenPro</span>
            </div>
            <p class="stat-label">certified product</p>
          </div>
          <p class="stat-sub">Lifecycle-verified from source to end-of-life.</p>
        </div>
    </div>
  </div>
  <div class="outer-btn-wrap outer-bg-white outer-btn-spacing absolute left-0 bottom-0">
        <a class="site-link" href="#">
          Read our sustainability story
          <span class="site-link-arrow" aria-hidden="true"><img src="Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover"></span>
        </a>
  </div>
</section>

