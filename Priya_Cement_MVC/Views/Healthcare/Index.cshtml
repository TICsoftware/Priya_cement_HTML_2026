}

      <!-- HERO BANNER END-->
      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="Assets/images/banners/company-info-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="Assets/images/banners/company-info-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="Assets/images/banners/company-info-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-5xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 Business & Corporates
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                           Nekta - 
                           <span class="innerbanner-title-span">
                              Healthcare
                           </span>
                        </h1>

                     </div>
                  </div>
               </div>
           

         </div>
      </section>
      <!-- HERO BANNER END -->

      <!-- ==================== INTR0- DELIVERING EXPERIENCES ==================== -->
         <section class=" bc-experience-section relative section-spacing overflow-hidden page-intro-section">
            <!-- Decorative sushi platter on far right -->
            <img loading="lazy" src="Assets/images/business/icon-right.svg" alt=""
               class="bc-deco hidden xl:block w-40 -right-0 top-1/4" aria-hidden="true" />
            <div class="container relative z-10">
               <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                  <!-- Left: plate in circle -->
                  <div class="relative">
                     <div class="bc-plate-wrap">
                        <img loading="lazy" src="Assets/images/business/plate-circle.png" alt="Signature Nekta plate"
                           class="bc-plate-img" />
                        <img loading="lazy" src="Assets/images/business/coriander.svg" alt=""
                           class="bc-plate-mini" aria-hidden="true" />
                     </div>
                  </div>
                  <!-- Right: copy -->
                  <div class="relative space-y-6 md:space-y-8 sm:max-w-[35vw]">
                     <div class="section-title-outer mx-auto max-w-5xl">
                        <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                           Nutrition That Heals. Standards  <span class="text-letters-slide"> That Protect.</span>
                        </h2>
                        
                     </div>
                    <div class="intro-outer-wrapper sm:pl-15">
                     <p>From patient meal programmes to associate cafeterias, visitor food courts and round-the-clock food services, Nekta brings the precision of aviation hospitality and the trust of institutional catering to the most demanding sector in food service. Our associations with leading hospitals reflect our ability to operate within stringent clinical, hygiene and dietary standards delivering food programmes that support recovery, sustain caregivers and reassure families.</p>
                     <div class="flex justify-start mt-5">
                           <a href="#" class="common-btn flex items-center gap-2 btn-slide-fill">
                           <span>Get in Touch</span>
                           <img loading="lazy" src="Assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                           </a>
                        </div>
                     </div>
                     <!-- Decorative leaf bottom-right -->
                  <img loading="lazy" src="Assets/images/intro-leaf/green_leaf_travel.svg" alt="" class="bc-leaf-deco absolute -bottom-6 right-0 md:right-4 w-10 md:w-12" aria-hidden="true" />

                  </div>
               </div>
            </div>
         </section>

         <!-- ==================== THREE TILT CARD ==================== -->
         <section class="bg-darkcream story-gallery section-spacing">
            <!-- Section Heading -->
               <div class="section-title-outer text-center mx-auto max-w-5xl">
                  <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                   Healthcare <span class="text-letters-slide"> Dining Excellence </span>
                  </h2
               </div>
            <!-- Intro paragraphs -->
                  <div class="story-intro text-center max-w-5xl mx-auto mb-25 mt-10">
                     <p>We curate integrated healthcare dining experiences where every meal is engineered around clinical needs, nutritional integrity and the highest hygiene standards. From therapeutic diets and dietitian-approved menus every element is designed to reflect the premium standards modern healthcare institutions stand for.</p>
                     <p>With deep operational expertise in high-volume institutional environments, we partner with leading healthcare providers to design, manage and continuously refine food programmes that earn the trust of patients, doctors, hospital administrators and families.</p>
                  </div>

            <div class="container">
               <div class="relative">
                  <div class="story-gallery-left">
                     <img src="assets/images/healthcare/left_decor.webp" class="max-w-auto">
                  </div>
                  <div class="story-gallery-right">
                     <img src="assets/images/healthcare/right_decor.webp" class="max-w-auto z-10 story-turmuric">
                      <img src="assets/images/healthcare/right_decor_leaf.webp" alt="" class="max-w-auto z-10 story-leaf">
                  </div>
                  <!-- Cards -->
                  <div class="cards-wrapper relative flex justify-center items-center">
                     <!-- Left -->
                     <div class="gallery-card gallery-left">
                        <img src="assets/images/about-us/card-1.png" alt="">
                     </div>
                     <!-- Center -->
                     <div class="gallery-card gallery-center">
                        <img src="assets/images/about-us/card-2.jpg" alt="">
                     </div>
                     <!-- Right -->
                     <div class="gallery-card gallery-right">
                        <img src="assets/images/about-us/card-3.jpg" alt="">
                     </div>
                  </div>
               </div>
            </div>
         </section>


