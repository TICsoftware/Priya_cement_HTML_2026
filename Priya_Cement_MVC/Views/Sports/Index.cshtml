        <!-- HERO BANNER END-->
      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="Assets/images/banners/company-info-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="Assets/images/banners/company-info-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="Assets/images/banners/company-info-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-4xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 About Us
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                          Life is a 
                           <span class="innerbanner-title-span">
                              Beautiful Plate
                           </span>
                        </h1>

                     </div>
                  </div>
               </div>
           

         </div>
      </section>


         <!-- ====================Intro Section Delivering Experiences that Matter ==================== -->
         <section class=" bc-experience-section relative section-spacing overflow-hidden page-intro-section">

            <div class="container relative z-10">
               <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                  <!-- Left:img  -->
                  <div class="relative">
                  <div class="nourish-media">
                     <img
                        src="Assets/images/education/next_generation.png"
                        alt="Nourishing the Next Generation">
                  </div>
                  </div>
                  <!-- Right: copy -->
                  <div class="relative space-y-6 md:space-y-8 sm:max-w-[35vw]">
                     <div class="section-title-outer mx-auto max-w-5xl">
                        <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                          Fuel Engineered   <span class="text-letters-slide">for Performance</span>
                        </h2>
                        
                     </div>
                    <div class="intro-outer-wrapper sm:pl-15">
                     <p>From athlete-led nutritionist meals and residential sporting academy dining to stadium catering services, Nekta brings its expertise to the performance-driven sector in food service. As a wholly owned subsidiary of TajSATS, we deliver large-scale catering solutions to sports academies, professional teams, tournaments and venues engineered around dietary precision, and operational reliability that high-stakes sports demand.</p>
                     <div class="flex justify-start mt-5">
                           <a href="#" class="common-btn flex items-center gap-2 btn-slide-fill">
                           <span>Get in Touch</span>
                           <img loading="lazy" src="Assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                           </a>
                        </div>
                     </div>
                  
                  <!-- Decorative leaf bottom-right -->
                  <img loading="lazy" src="Assets/images/intro-leaf/green_leaf_travel.svg" alt="" class="bc-leaf-deco absolute -bottom-6 right-0 md:right-4 w-10 md:w-12" aria-hidden="true" />

                  </div>
               </div>
            </div>
         </section>

      
      <!-- ==================== Campus Dining Excellence==================== -->
      <!-- ==================== Sports Catering Excellence ==================== -->
<section class="bg-darkcream sce-section relative section-spacing ">
   <div class="container relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

         <!-- Left: copy on backdrop card -->
         <div class="relative sce-copy-wrap">
            <span class="sce-backdrop" aria-hidden="true"></span>

            <div class="relative sce-copy">
                     <div class="section-title-outer mx-auto max-w-5xl">
                        <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                           Sports <span class="text-letters-slide"> Catering Excellence </span>
                        </h2>
                     </div>
               <p class="mb-5">Nekta designs and delivers specialised institutional catering solutions for sports academies, professional teams, tournaments, and venues—recognising food as a critical driver of performance, not an afterthought.</p>

               <p class="mb-5">Our approach centres on aligning nutrition with training intensity, performance goals, and recovery needs. Menus are developed in collaboration with sports nutritionists, thoughtfully executed by our culinary teams, and delivered with precision and consistency at scale.</p>

               <p>Built on the strong foundation of TajSATS, Nekta ensures reliability, nutritional integrity, and operational excellence across every sporting engagement—supporting athletes with the nourishment they need to perform at their best.</p>


            </div>
         </div>

         <!-- Right: tilted photo -->
         <div class="relative sce-photo-wrap">
            <img loading="lazy"
               src="assets/images/sports/right_side_img.webp"
               alt="Sports catering presentation, freshly prepared for athletes"
               class="sce-photo"
               data-sce-photo />
         </div>

      </div>
   </div>
</section>

