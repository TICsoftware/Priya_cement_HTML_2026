@{
    ViewData["Title"] = "Technical Services";
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/technicalservices-style.css" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-131.25 relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/technicalservices-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="~/Assets/images/banners/technicalservices-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/technicalservices-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                  <div class="container">
                     <div class="max-w-4xl text-left">

                        <h1 class="innerbanner-title text-h1 text-white">
                         Technical Services (MTV)
                        </h1>

                        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>
                              <li class="text-white/60">/</li>
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Products
                                 </a>
                              </li>
                              <li class="text-white/60">/</li>
                              <li class="text-white">
                                 Technical Services (MTV)
                              </li>
                           </ol>
                        </nav>

                     </div>
                  </div>
               </div>
           

         </div>
   </section>
    <!-- HERO BANNER END -->

   



@section Scripts {
    <script src="~/Assets/js/inner-banner-script.js"></script>
    <script src="~/Assets/js/technicalservices-script.js"></script>
  
    
}

