<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}

  <!-- ✅ Favicon -->
  <link rel="icon" href="~/Assets/images/favicon/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="~/Assets/images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="~/Assets/images/favicon/favicon-16x16.png">
  <!-- Apple -->
  <link rel="apple-touch-icon" href="~/Assets/images/favicon/apple-touch-icon.png">
  <!-- Android -->
  <link rel="icon" type="image/png" sizes="192x192" href="~/Assets/images/favicon/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="~/Assets/images/favicon/android-chrome-512x512.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">



  @RenderSection("head", required: false)
  
  <link rel="preload" href="~/dist/site.css" as="style"  onload="this.onload=null;this.rel='stylesheet'" asp-append-version="true">
  <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />

  
  <link rel="stylesheet" href="~/Assets/css/swiper-bundle.min.css" />
  <link rel="preload" href="~/Assets/css/header-footer.css" as="style">
  <link rel="stylesheet" href="~/Assets/css/header-footer.css">
  <link rel="preload" href="~/Assets/css/common-style.css" as="style">
  <link rel="stylesheet" href="~/Assets/css/common-style.css">

  <link rel="stylesheet" href="~/Assets/css/three-box-slider.css">
  <link rel="stylesheet" href="~/Assets/css/center-mode-slider.css">
  <link rel="stylesheet" href="~/Assets/css/blogs-cards-slider.css">
<link rel="stylesheet" href="~/Assets/css/assistant-popup.css">

  @RenderSection("Styles", required: false)
</head>

<body>
   <noscript>
    <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KKXV4K9H" height="0" width="0"
      style="display:none;visibility:hidden"></iframe>
  </noscript> 
  
  @{
    var isHomePage =
    ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
    ViewContext.RouteData.Values["action"]?.ToString() == "Index";
  }

 @Html.Partial("~/Views/Shared/_Header.cshtml")

  <div class="hero-assistant fixed top-1/2 right-0 z-50">
               <button type="button" class="assistant-trigger" data-modal-open="contactModal"
                  aria-label="Open assistant enquiry form">
               <img loading="lazy" src="assets/images/assistant.png" alt="" class="hero-section-ass-img" aria-hidden="true"
                  />
               </button>
            </div>

      <main id="main-content">
         <!--============================================
         1: HERO SECTION 
         =============================================-->
         <section class="hero-section relative h-[75svh] md:h-screen flex items-center justify-center overflow-hidden">
           
            <!-- HERO MEDIA SLIDER (image + video slides) -->
            <div class="hero-media-swiper swiper absolute inset-0 w-full h-full">
               <div class="swiper-wrapper">
                  <!-- Slide 1: video -->
                  <div class="swiper-slide hero-slide" >
                     <video class="hero-media" muted playsinline preload="auto">
                        <source src="assets/video/Bubble.mp4" type="video/mp4" />
                     </video>

                        <!-- Caption: stays centered and syncs with the active slide -->
                        <div class="hero-caption-overlay absolute inset-0 flex items-center justify-center text-center px-4 pointer-events-none z-30">                        
                           <div class="hero-caption-inner section-title-outer ">
                              <h1 class="hero-caption-title title-section text-letters-slide">Where Diagnostics <span class="balkist-bolditalic ">Meets Compassion</span></h1>
                              <p class="hero-caption-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>                

                              <a href="#" class="common-btn mt-8 md:mt-12 btn-slide-fill" type="button">
                                 <span>Learn More</span>
                                 <img loading="lazy" src="assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                              </a>
                           </div>
                        </div>
                  </div>

                  <!-- Slide 2: image (add/remove slides as needed) -->
                  <div class="swiper-slide hero-slide" data-caption="">
                     <img loading="lazy" src="~/Assets/images/homepage/banner/banner-img1.webp" alt=""
                        class="hero-media" />

                        <!-- Caption: stays centered and syncs with the active slide -->
                     <div class="hero-caption-overlay absolute inset-0 flex items-center justify-center text-center px-4 pointer-events-none z-30">
                        <div class="hero-caption-inner">
                            <h1 class="hero-caption-title title-section">Precision You Can  <span class="balkist-bolditalic text-letters-slide">Trust</span></h1>
                           <p class="hero-caption-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>                

                           <a href="#" class="common-btn mt-8 md:mt-12 btn-slide-fill" type="button">
                              <span>Learn More</span>
                              <img loading="lazy" src="assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                           </a>
                        </div>
                     </div>
                  </div>
               </div>
            </div>

            <!-- Slide break: solid panel that wipes left-to-right on load and on every slide change -->
            <div class="hero-slide-break" aria-hidden="true"></div>        


            <!-- Slider controls: shown by JS only when there is more than one slide -->
            <div class="hero-swiper-controls">
               <button type="button" class="hero-swiper-prev" aria-label="Previous slide"></button>
               <div class="hero-swiper-pagination"></div>
               <button type="button" class="hero-swiper-next" aria-label="Next slide"></button>
            </div>

            <!-- Overlay -->
            <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10 pointer-events-none"></div>

            <!-- Floating Particles -->
            <div class="absolute inset-0 pointer-events-none z-10">
               <div
                  class="particle absolute w-1.5 h-1.5 md:w-2 md:h-2 bg-green-400 rounded-full top-1/4 left-5 md:left-10 opacity-30">
               </div>
               <div class="particle absolute w-1 h-1 bg-green-400 rounded-full top-1/3 left-1/4 md:left-1/3 opacity-40"
                  style="animation-delay: 3s"></div>
               <div class="particle absolute w-2 h-2 md:w-3 md:h-3 bg-green-400 rounded-full top-2/3 left-3/4 md:left-2/3 opacity-20"
                  style="animation-delay: 7s"></div>
            </div>
         </section>




         <!--========================================
         2: Seeking an Elevated Dining Experience
         ========================================-->
         <section class="bg-darkcream section-spacing  text-center overflow-hidden">
            <div class="container">
               <div class="section-title-outer mx-auto max-w-5xl">
                  <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                     Seeking an Elevated <span class="text-letters-slide"> Dining Experience</span>
                  </h2>
                   <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
               </div>

               <a href="#" class="common-btn mt-8 md:mt-12 btn-slide-fill" type="button" data-modal-open="contactModal">
                  <span>Get in Touch</span>
                  <img loading="lazy" src="assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
               </a>
            </div>   
         </section>


         <!-- ==================== ===========
         3: From the house trusted on air to delighting on ground Serving up a beautiful world of  food inbetween
         =================================== -->
         <section class="about-section section-spacing overflow-hidden">
            <div class="container">
               <div class="about-grid grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                  <!-- Left Text -->
                  <div class="space-y-6 md:space-y-8">                  
                     <div class="section-title-outer">
                        <h2 class="title-section  text-h2 " data-leaf-target letters-slide-down text-split>From the house trusted on air to delighting on ground;<br />Serving up a beautiful world of  <span class="text-letters-slide">  food inbetween</span></h2>
                       
                     </div>
                   
                     <div class="about-copy space-y-6 px-0 md:px-8 relative">
                        <p>A hallmark of catering excellence, trusted by institutions, driven by innovation, Nekta Food Solutions Limited is an organization built to elevate the experience of everyday
                           dining into an art.</p>
                        <p>Backed by the legacy of TajSATS, India’s market leader in aviation hospitality Nekta brings the agility of youthful innovation and the lived wisdom of experience to
                           everyday institutional dining.</p>

                    


                         <div class="flex justify-start mt-6">
                              <a href="#" class="common-btn flex items-center gap-2 btn-slide-fill">
                              <span>About us</span>
                              <img loading="lazy" src="assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                              </a>
                           </div> 

                        <div class="leafimg leaf-field pointer-events-none absolute z-20 overflow-visible">
                           <img loading="lazy" src="assets/images/leafimg.png" alt="leafImg"
                              class="leaf-motion leaf-image absolute top-0 left-0 opacity-0 transform-gpu will-change-transform select-none" />
                        </div>
                     </div>
                  </div>
                  <!-- Right Image Collage -->
                  <div class="image-collage-sway collage-stage relative w-full mx-auto lg:ml-auto overflow-visible">
                     <!-- First image - no animation -->
                     <img loading="lazy" src="assets/images/turnImg.png" alt="Decorative"
                        class="collage-turn absolute z-20 select-none" />
                     <!-- Top Right Image -->
                     <div data-range="30" data-hover="20" data-idle="12" data-scale="1.03" data-dir="rtl"
                        class="sync-pan-item collage-item-top absolute right-0 z-20 cursor-pointer">
                        <div class="media-frame lefttop relative overflow-hidden bg-transparent rounded-lg border-8 border-(--color-darkcream)">
                           <img loading="lazy" src="assets/images/about/image1.png" alt="" aria-hidden="true"
                              class="block w-full h-auto opacity-0 pointer-events-none select-none" />
                           <img loading="lazy" src="assets/images/about/image1.png" alt="Buffet Service"
                              class="sync-pan-inner pan-image-top absolute inset-0 h-full max-w-none object-cover transform-gpu will-change-transform pointer-events-none select-none" />
                           <div
                              class="overlay-base overlay-rounded absolute inset-0 bg-black/20 opacity-0 pointer-events-none">
                           </div>
                           <div
                              class="overlay-sweep overlay-sweep-right overlay-rounded absolute inset-y-0 bg-gradient-to-l from-black/30 via-black/15 to-transparent opacity-0 pointer-events-none">
                           </div>
                        </div>
                     </div>
                     <!-- Bottom Left Image -->
