<!-- ==================== Realted Blogs==================== -->
<section class="section-pb relative overflow-hidden">
  
    <div class="container">

        <!-- Section Heading -->
                 <!-- Section Heading -->
               <div class="section-title-outer text-center max-w-8xl mx-auto">
                  <h2 class="title-section text text-h2" data-leaf-target letters-slide-down text-split>Realted  <span class="text-letters-slide">Blogs</span>
                  </h2>
                 
               </div>

        <!-- Blog Cards Grid -->
        <div class="blogs-cards-grid">

               <div class="insight-card blogs-cards-wrapper">
                  <div class="media-frame blogs-cards-image">
                     <img loading="lazy" src="Assets/images/insights/trend1.png" alt="Catering Trends" />
                     <span class="pill">Case study</span>
                  </div>
                  <div class="blogs-cards-content">
                     <span class="post-date">21 July 2026</span>
                     <h3 class="insight-title">Top Catering Trends Transforming Modern Celebrations</h3>
                     <a href="#" class="link-md link-primary">
                           <span class="underline">Read More</span>
                           <img loading="lazy" src="Assets/images/arrows/orangearrow-long-right.png" alt="rightArrow" />
                     </a>
                  </div>
               </div>
            <div class="insight-card blogs-cards-wrapper">
                <div class="media-frame blogs-cards-image">
                    <img loading="lazy" src="Assets/images/insights/chef-creativity.png" alt="Chef Creativity" />
                    <span class="pill">Case study</span>
                </div>
                <div class="blogs-cards-content">
                    <span class="post-date">21 July 2026</span>
                    <h3 class="insight-title">How Our Chefs Craft Authentic Flavours with Creativity</h3>
                    <a href="#" class="link-md link-primary">
                        <span class="underline">Read More</span>
                        <img loading="lazy" src="Assets/images/arrows/orangearrow-long-right.png" alt="rightArrow" />
                    </a>
                </div>
            </div>

            <div class="insight-card blogs-cards-wrapper">
                <div class="media-frame blogs-cards-image">
                    <img loading="lazy" src="Assets/images/insights/premium-catering.png" alt="Premium Catering" />
                    <span class="pill">Case study</span>
                </div>
                <div class="blogs-cards-content">
                    <span class="post-date">21 July 2026</span>
                    <h3 class="insight-title">Featured for Excellence in Premium Catering Experiences</h3>
                    <a href="#" class="link-md link-primary">
                        <span class="underline">Read More</span>
                        <img loading="lazy" src="Assets/images/arrows/orangearrow-long-right.png" alt="rightArrow" />
                    </a>
                </div>
            </div>
             
            <!-- repeat this .insight-card block for each additional post -->

        </div>



    </div>
</section>






    

