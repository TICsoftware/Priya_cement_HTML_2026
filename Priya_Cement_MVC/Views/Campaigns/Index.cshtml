@{
    ViewData["Title"] = "Campaigns & TVCs";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/media-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/video-modal.css" asp-append-version="true" />
}

   <!-- HERO BANNER -->
   <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-131.25 relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/financialinformation-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:992px)"
                     srcset="~/Assets/images/banners/financialinformation-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/financialinformation-banner-mob.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                  <div class="container">
                     <div class="max-w-4xl text-left">

                        <h1 class="innerbanner-title text-h1 text-white">
                         Campaigns &amp; TVCs
                        </h1>

                        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                Campaigns &amp; TVCs
                              </li>
                           </ol>
                        </nav>

                     </div>
                  </div>
               </div>
           

         </div>
   </section>
   <!-- HERO BANNER END -->

   <section class="section-spacing fi-reports-section" aria-labelledby="fi-reports-heading">
      <div class="container">
         <div class="section-title-outer section-title-outer-start section-title-md section-title-left">
            <h2 class="text-h2 title-section reveal-text">
               TVC
            </h2>
            <p>A market player since August 1986, Priya Cement is one of the biggest and most recognized cement brands in India. </p>
         </div>

         <div class="video-card-grid video-card-grid-logo">
            <a class="video-card" href="#" data-video-src="/Assets/images/video/Priya-english.mp4" aria-label="Play Priya Cement English TVC">
               <span class="video-card-media">
                  <img src="~/Assets/images/tvc/corporate-film.webp" alt="Priya Cement English TVC" width="640" height="360" loading="lazy">
               </span>
               <span class="video-card-play" aria-hidden="true"></span>
            </a>

            <a class="video-card" href="#" data-video-src="/Assets/images/video/Priya-english.mp4" aria-label="Play Priya Cement Telugu TVC">
               <span class="video-card-media">
                  <img src="~/Assets/images/tvc/telugu.webp" alt="Priya Cement Telugu TVC" width="640" height="360" loading="lazy">
               </span>
               <span class="video-card-play" aria-hidden="true"></span>
            </a>

            <a class="video-card" href="#" data-video-src="/Assets/images/video/Priya-english.mp4" aria-label="Play Priya Cement Kannada TVC">
               <span class="video-card-media">
                  <img src="~/Assets/images/tvc/kannada.webp" alt="Priya Cement Kannada TVC" width="640" height="360" loading="lazy">
               </span>
               <span class="video-card-play" aria-hidden="true"></span>
            </a>

            <a class="video-card" href="#" data-video-src="/Assets/images/video/Priya-english.mp4" aria-label="Play Priya Cement Malayalam TVC">
               <span class="video-card-media">
                  <img src="~/Assets/images/tvc/priya_malyalam.webp" alt="Priya Cement Malayalam TVC" width="640" height="360" loading="lazy">
               </span>
               <span class="video-card-play" aria-hidden="true"></span>
            </a>

            <a class="video-card" href="#" data-video-src="/Assets/images/video/Priya-english.mp4" aria-label="Play Priya Cement Tamil TVC">
               <span class="video-card-media">
                  <img src="~/Assets/images/tvc/tamil.webp" alt="Priya Cement Tamil TVC" width="640" height="360" loading="lazy">
               </span>
               <span class="video-card-play" aria-hidden="true"></span>
            </a>

            <a class="video-card" href="#" data-video-src="/Assets/images/video/Priya-english.mp4" aria-label="Play Priya Cement Telugu corporate movie">
               <span class="video-card-media">
                  <img src="~/Assets/images/tvc/corporate_movie_telugu.webp" alt="Priya Cement Telugu corporate movie" width="640" height="360" loading="lazy">
               </span>
               <span class="video-card-play" aria-hidden="true"></span>
            </a>
         </div>
      </div>
   </section>
   <section class="section-spacing relative overflow-hidden bgimage-section">
      <div class="bgimage-outer-wrap" aria-hidden="true">
         <img src="~/Assets/images/bg-image.webp" alt="" class="w-full h-full object-cover bg-image">
      </div>
      <div class="container relative z-1">
         <div class="section-title-outer section-title-outer-start section-title-md section-title-left">
            <h2 class="text-h2 title-section reveal-text">
               Corporate <span>Film</span>
            </h2>
            <p>A market player since August 1986, Priya Cement is one of the biggest and most recognized cement brands in India. </p>
         </div>

          <div class="video-card-grid video-card-grid-2 mt-5">
            <a class="video-card" href="#" data-video-src="/Assets/images/video/Priya-english.mp4" aria-label="Play Priya Cement English TVC">
               <span class="video-card-media">
                  <img src="~/Assets/images/tvc/corporate-film-2022.webp" alt="Priya Cement English Corporate Film" width="640" height="360" loading="lazy">
               </span>
               <span class="video-card-play" aria-hidden="true"></span>
            </a>

            <a class="video-card" href="#" data-video-src="/Assets/images/video/Priya-english.mp4" aria-label="Play Priya Cement Telugu corporate movie">
               <span class="video-card-media">
                  <img src="~/Assets/images/tvc/corporate-film-2022.webp" alt="" width="640" height="360" loading="lazy">
               </span>
               <span class="video-card-play" aria-hidden="true"></span>
            </a>
         </div>

      </div>
   </section>

@section Scripts {
   <script src="~/Assets/js/inner-banner-script.js" asp-append-version="true"></script>
   <script src="~/Assets/js/campaigns-script.js" asp-append-version="true"></script>
   <script src="~/Assets/js/video-modal.js" asp-append-version="true"></script>
}
