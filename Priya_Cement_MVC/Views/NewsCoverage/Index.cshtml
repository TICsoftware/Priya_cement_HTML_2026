@{
    ViewData["Title"] = "News and Coverage";
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/media-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/image-gallery.css" asp-append-version="true" />
}

   <!-- HERO BANNER -->
   <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-131.25 relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/financialinformation-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:992px)"
                     srcset="~/Assets/images/banners/financialinformation-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/financialinformation-banner-mob.webp"
                     alt=""
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                  <div class="container">
                     <div class="max-w-4xl text-left">

                        <h1 class="innerbanner-title text-h1 text-white">
                         News & Coverage
                        </h1>

                        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 News & Coverage
                              </li>
                           </ol>
                        </nav>

                     </div>
                  </div>
               </div>
           

         </div>
   </section>
   <!-- HERO BANNER END -->

   <section class="section-spacing print-section" aria-labelledby="print-heading">
      <div class="container">
         <div class="section-title-outer section-title-outer-start section-title-md section-title-left">
            <h2 class="text-h2 title-section reveal-text">
               Print
            </h2>
            <p>A market player since August 1986, Priya Cement is one of the biggest and most recognized cement brands in India.  </p>
         </div>

         <div class="image-gallery mt-5" data-gallery="print">
            <a class="image-gallery-card" href="/Assets/images/print/english_vert_adv.webp" aria-label="Priya Cement five elements print ad">
               <img src="~/Assets/images/print/english_vert_adv.webp" alt="Priya Cement five elements print ad" width="480" height="600" loading="lazy">
            </a>
            <a class="image-gallery-card" href="/Assets/images/print/english_adv.webp" aria-label="Priya Cement 100 crore bags print ad">
               <img src="~/Assets/images/print/english_adv.webp" alt="Priya Cement 100 crore bags print ad" width="480" height="600" loading="lazy">
            </a>
            <a class="image-gallery-card" href="/Assets/images/print/press_note.webp" aria-label="Priya Cement press note">
               <img src="~/Assets/images/print/press_note.webp" alt="Priya Cement press note" width="480" height="600" loading="lazy">
            </a>
            <a class="image-gallery-card" href="/Assets/images/print/ganesh_chaturthi.webp" aria-label="Priya Cement Ganesh Chaturthi greeting">
               <img src="~/Assets/images/print/ganesh_chaturthi.webp" alt="Priya Cement Ganesh Chaturthi greeting" width="480" height="600" loading="lazy">
            </a>
            <a class="image-gallery-card" href="/Assets/images/print/tarun_bharat.webp" aria-label="Priya Cement newspaper coverage">
               <img src="~/Assets/images/print/tarun_bharat.webp" alt="Priya Cement newspaper coverage" width="480" height="600" loading="lazy">
            </a>
            <a class="image-gallery-card" href="/Assets/images/print/vellore.webp" aria-label="Priya Cement Tamil print greeting">
               <img src="~/Assets/images/print/vellore.webp" alt="Priya Cement Tamil print greeting" width="480" height="600" loading="lazy">
            </a>
         </div>
      </div>
   </section>

   <section class="section-spacing gallery-section relative overflow-hidden bgimage-section" aria-labelledby="gallery-heading">
