@{
    ViewData["Title"] = "Products";
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/products-index-style.css" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-131.25 relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/products-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="~/Assets/images/banners/products-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/products-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                  <div class="container">
                     <div class="max-w-4xl text-left">

                        <h1 class="innerbanner-title text-h1 text-white">
                          Our Products
                        </h1>

                        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 Products
                              </li>
                           </ol>
                        </nav>

                     </div>
                  </div>
               </div>
           

         </div>
   </section>
    <!-- HERO BANNER END -->

    <section class="relative overflow-hidden section-spacing page-intro-outer">
      <div class="container">
         <div class="intro-outer-wrapper flex-col sm:flex-row gap-6 lg:gap-12 items-start">
            <div class="intro-title-col lg:max-w-[62%]">
               <div class="section-title-outer section-title-outer-start section-title-sm">
                  <h3 class="text-h2 title-section reveal-text">
                     Whatever you are building, there is a <span>Priya Cement</span> made for it
                  </h3>
               </div>
            </div>
            <div class="intro-copy-col lg:max-w-[38%]">
               <p>
                  Choosing the right cement starts with understanding your project's unique requirements.
                  Whether you need faster curing, higher strength or long-term durability, Priya Cement
                  offers three specialised products designed for every build.
               </p>
            </div>
         </div>
      </div>
    </section>

    <section class="relative section-pt">
      <div class="container">
         <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-8 lg:gap-y-24 our-products-landing-cards">

               <!-- Card 1: MAXLOAD -->
               <article class="group rounded-md flex flex-col hover:shadow-lg hover:shadow-slate-200/60 transition-shadow duration-300 our-products-cards">
                  <div class="flex items-center justify-center mb-6 our-products-img">
                     <img src="~/Assets/images/products/MAXLOAD.webp" alt="" class="h-full w-auto object-contain drop-shadow-sm">
                  </div>
                  <div class="our-products-content">
                  <h3>
                     MAXLOAD <span>(OPC — 53 Grade)</span>
                  </h3>
                  <p>
                  A high-strength Ordinary Portland Cement engineered for moisture-load-bearing applications. It achieves 65 MPa at 28 days, and 24% above the IS 269:2015 minimum, making it the right choice where the structure needs to reach full strength fast and hold it indefinitely.
                  </p>
                  <div class="outer-btn-wrap">
                     <a class="site-link" href="#">
                      Explore More
                      <span class="site-link-arrow" aria-hidden="true"><img src="Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover"></span>
                    </a>
                  </div>
                  </div>
               </article>
            
               <!-- Card 2: PPC -->
                <article class="group rounded-md flex flex-col hover:shadow-lg hover:shadow-slate-200/60 transition-shadow duration-300 our-products-cards">
                  <div class="flex items-center justify-center mb-6 our-products-img">
                     <img src="~/Assets/images/products/PPC.webp" alt="" class="h-full w-auto object-contain drop-shadow-sm">
                  </div>
                  <div class="our-products-content">
                     <h3>
                     Portland Pozzolana Cement <span>(PPC)</span>
                     </h3>
                     <p>
                     Blended with fly ash from thermal power plants, this cement delivers lower permeability, superior sulphate resistance, and long-term strength that continues to grow beyond 28 days. It achieves 53 MPa at 28 days, well in 40% above the IS 1489 (Part 1) 2015 minimum requirement of 33 MPa.
                     </p>
                     <div class="outer-btn-wrap">
                        <a class="site-link" href="#">
                        Explore More
                        <span class="site-link-arrow" aria-hidden="true"><img src="Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover"></span>
                     </a>
                     </div>
                  </div>
               </article>
            
               <!-- Card 3: MAXLOAD Bulk Cement -->
                <article class="group rounded-md flex flex-col hover:shadow-lg hover:shadow-slate-200/60 transition-shadow duration-300 our-products-cards">
                  <div class="flex items-center justify-center mb-6 our-products-img">
                     <img src="~/Assets/images/products/bulk-cement.webp" alt="" class="h-full w-auto object-contain drop-shadow-sm">
                  </div>
                  <div class="our-products-content">
                     <h3>
                     MAXLOAD Bulk Cement
                     </h3>
                     <p>
                     Manufactured from 95% high-purity limestone and delivered factory-fresh within 12 to 18 hours, MAXLOAD Bulk Cement delivers 20% higher 28-day strength and 30% higher 3-day strength compared to minimum IS requirements, at the volume large-scale construction demands.
                     </p>
                  <div class="outer-btn-wrap">
                        <a class="site-link" href="#">
                        Explore More
                        <span class="site-link-arrow" aria-hidden="true"><img src="Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover"></span>
                     </a>
                     </div>
                   </div>
               </article>
            
               <!-- Card 4: Service MTV -->
                <article class="group rounded-md flex flex-col hover:shadow-lg hover:shadow-slate-200/60 transition-shadow duration-300 our-products-cards">
                  <div class="flex items-center justify-center mb-6 our-products-img">
                     <img src="~/Assets/images/products/Service-MTV.webp" alt="" class="h-full w-auto object-contain drop-shadow-sm">
                  </div>
                  <div class="our-products-content">
                     <h3>
                     Service MTV
                     </h3>
                     <p>
                     From on-site testing that verifies cement quality without the need for lab visits to expert technical guidance on mix design, curing, material selection, and construction best practices, Priya Cement helps keep every project on track with practical support where and when you need it.
                     </p>
                     <div class="outer-btn-wrap">
                        <a class="site-link" href="#">
                        Explore More
                        <span class="site-link-arrow" aria-hidden="true"><img src="Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover"></span>
                     </a>
                     </div>
                  </div>
               </article>
            
         </div>
      </div>
    </section>

   <section class="relative section-pb bg-parallax-section">
      <div class="outer-bg-wrap">
         <div class="container relative z-1 bg-parallax-stage">

            <!-- Clipped card (bg stays inside rounded frame) -->
            <div class="bg-parallax-frame relative min-h-[660px] rounded-sm overflow-hidden">
               <div class="parallax-wrap rounded-sm" aria-hidden="true">
                  <img
                     src="Assets/images/products/image1.webp"
                     alt=""
                     class="parallax-img rounded-sm"
                     loading="lazy"
                     decoding="async">
               </div>
               <div class="overlay-scrim rounded-sm" aria-hidden="true"></div>

               <div class="bg-parallax-content relative z-2">
                  <div class="section-title-outer section-title-outer-start section-title-sm white-copy">
                     <h3 class="text-h2 title-section reveal-text">
                        Not sure which product is right for your project?
                     </h3>
                  </div>
               </div>

               <div class="outer-btn-wrap outer-bg-white outer-btn-spacing absolute left-0 bottom-0 z-3">
                  <a class="site-link" href="#">
                     Speak to our technical team
                     <span class="site-link-arrow" aria-hidden="true">
                        <img src="Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover">
                     </span>
                  </a>
               </div>
            </div>

            <!-- Man sits outside the card so the head can break out above -->
            <div class="man-image-wrap" aria-hidden="true">
               <img
                  src="Assets/images/products/image2.webp"
                  alt=""
                  class="man-image-img"
                  loading="lazy"
                  decoding="async">
            </div>

         </div>
      </div>
   </section>




@section Scripts {
    <script src="~/Assets/js/inner-banner-script.js"></script>
    <script src="~/Assets/js/products-index-script.js"></script>
  
    
}

