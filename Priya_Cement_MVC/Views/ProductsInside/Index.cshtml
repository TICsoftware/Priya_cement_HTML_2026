@{
    ViewData["Title"] = "Products Inside";
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/products-inside-style.css" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-131.25 relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/productsinside-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="~/Assets/images/banners/productsinside-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/productsinside-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                  <div class="container">
                     <div class="max-w-5xl text-left">

                        <h1 class="innerbanner-title text-h1 text-white">
                          MAXLOAD OPC - 53 Grade
                        </h1>

                        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 Products
                              </li>
                           </ol>
                        </nav>

                     </div>
                  </div>
               </div>
           

         </div>
   </section>
    <!-- HERO BANNER END -->

    <section class="relative overflow-hidden section-spacing page-intro-outer">
      <div class="container">
         <div class="intro-outer-wrapper flex-col flex gap-6 lg:gap-12 items-start">
            <div class="intro-title-col lg:max-w-5xl">
               <div class="section-title-outer section-title-outer-start section-with-intro">
                  <h2 class="text-h2 title-section reveal-text">
                     Engineered for <span>maximum strength</span>
                  </h2>
                  <p>MAXLOAD OPC — 53 Grade is a high-strength Ordinary Portland Cement engineered for structural applications, delivering reliable performance across residential, commercial, industrial, and infrastructure projects.</p>
               </div>
            </div>
         </div>

         <h3 class="mt-14 text-h4">Best for</h3>
         <div class="mt-4 border-t border-[#EAEAEA] pt-10 lg:max-w-5xl">
            <div class="grid gap-x-16 gap-y-10 sm:grid-cols-2 ">
               <div class="flex items-center gap-6">
                  <img src="~/Assets/images/products/bestfor/high-rise-buildings.svg" alt="" class="h-auto w-auto object-cover shrink-0">
                  <p class="text-20 font-medium">High-rise buildings</p>
               </div>
               <div class="flex items-center gap-6">
                  <img src="~/Assets/images/products/bestfor/industrial-structures.svg" alt="" class="h-auto w-auto object-cover shrink-0">
                  <p class="text-20 font-medium">Industrial structures</p>
               </div>
               <div class="flex items-center gap-6">
                  <img src="~/Assets/images/products/bestfor/bridges-flyovers.svg" alt="" class="h-auto w-auto object-cover shrink-0">
                  <p class="text-20 font-medium">Bridges and flyovers</p>
               </div>
               <div class="flex items-center gap-6">
                  <img src="~/Assets/images/products/bestfor/rcc-structures.svg" alt="" class="h-auto w-auto object-cover shrink-0">
                  <p class="text-20 font-medium">RCC structures</p>
               </div>
            </div>
         </div>

      </div>
    </section>

   <section class="bg-[#F4F4F4] section-spacing">
    <div class="container">
      <h3 class="text-h4">Why experts choose MAXLOAD OPC — 53 Grade</h3>
      <div class="mt-4 grid gap-10 border-t border-surface-line pt-12 lg:max-w-6xl lg:grid-cols-2 lg:gap-x-16">

        <article class="flex gap-7">
          <span class="grid h-[86px] w-[86px] shrink-0 place-items-center rounded-2xl bg-white shadow-tile">
           <img src="~/Assets/images/products/whyexperts/rapid-strength-gain.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div>
            <h4 class="text-20">Rapid strength gain</h4>
            <p>MAXLOAD OPC - 53 Grade achieves significant compressive strength within the first three days of curing, allowing earlier formwork stripping and faster progression to the next stage of construction.</p>
          </div>
        </article>

        <article class="flex gap-7">
          <span class="grid h-[86px] w-[86px] shrink-0 place-items-center rounded-2xl bg-white shadow-tile">
            <img src="~/Assets/images/products/whyexperts/built-heavy-loads.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div>
            <h4 class="text-20">Built for heavy loads</h4>
            <p>With a 28-day compressive strength of 66 MPa, MAXLOAD OPC - 53 Grade is engineered for structures where load-bearing capacity is the primary design requirement.</p>
          </div>
        </article>

        <article class="flex gap-7">
          <span class="grid h-[86px] w-[86px] shrink-0 place-items-center rounded-2xl bg-white shadow-tile">
            <img src="~/Assets/images/products/whyexperts/reduces-construction-time.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div>
            <h4 class="text-20">Reduces construction time</h4>
            <p>High early strength development means project timelines can be shortened without compromising structural integrity, a critical advantage for time-bound infrastructure and commercial projects.</p>
          </div>
        </article>

        <article class="flex gap-7">
          <span class="grid h-[86px] w-[86px] shrink-0 place-items-center rounded-2xl bg-white shadow-tile">
            <img src="~/Assets/images/products/whyexperts/consistent-across-batches.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div>
            <h4 class="text-20">Consistent across batches</h4>
            <p>Manufactured under continuous quality monitoring and tested against Bureau of Indian Standards specifications, every batch of MAXLOAD OPC - 53 Grade delivers the same level of performance.</p>
          </div>
        </article>

        <article class="flex gap-7">
          <span class="grid h-[86px] w-[86px] shrink-0 place-items-center rounded-2xl bg-white shadow-tile">
            <img src="~/Assets/images/products/whyexperts/proven-demanding-applications.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          </span>
          <div>
            <h4 class="text-20">Proven in demanding applications</h4>
            <p>From high-rise buildings and industrial structures to pre-stressed concrete and infrastructure projects, MAXLOAD OPC - 53 Grade has a verified track record across the most demanding construction environments.</p>
          </div>
        </article>

        <article class="flex gap-7">
          <span class="grid h-[86px] w-[86px] shrink-0 place-items-center rounded-2xl bg-white shadow-tile">
            <img src="~/Assets/images/products/whyexperts/manufactured-exceed.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div>
            <h4 class="text-20">Manufactured to exceed, not just meet the standard</h4>
            <p>MAXLOAD's actual test results consistently exceed IS 269:2015 requirements across physical, mechanical and chemical parameters, not by a narrow margin but by a measurable one.</p>
          </div>
        </article>
      </div>
    </div>
   </section>





@section Scripts {
    <script src="~/Assets/js/inner-banner-script.js"></script>
    <script src="~/Assets/js/products-inside-script.js"></script>
  
    
}

