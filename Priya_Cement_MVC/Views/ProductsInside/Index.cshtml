@{
    ViewData["Title"] = "Products Inside";
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/products-inside-style.css" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-131.25 relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/productsinside-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="~/Assets/images/banners/productsinside-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/productsinside-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                  <div class="container">
                     <div class="max-w-5xl text-left">

                        <h1 class="innerbanner-title text-h1 text-white">
                          MAXLOAD OPC - 53 Grade
                        </h1>

                        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 Products
                              </li>
                           </ol>
                        </nav>

                     </div>
                  </div>
               </div>
           

         </div>
   </section>
    <!-- HERO BANNER END -->

    <section class="relative overflow-hidden section-spacing page-intro-outer">
      <div class="container">
         <div class="intro-outer-wrapper flex-col flex gap-6 lg:gap-12 items-start">
            <div class="intro-title-col lg:max-w-4xl">
               <div class="section-title-outer section-title-outer-start section-with-intro">
                  <h2 class="text-h2 title-section reveal-text">
                     Engineered for <span>maximum strength</span>
                  </h2>
                  <p>MAXLOAD OPC — 53 Grade is a high-strength Ordinary Portland Cement engineered for structural applications, delivering reliable performance across residential, commercial, industrial, and infrastructure projects.</p>
               </div>
            </div>
         </div>
      </div>
    </section>





@section Scripts {
    <script src="~/Assets/js/inner-banner-script.js"></script>
    <script src="~/Assets/js/products-inside-script.js"></script>
  
    
}

