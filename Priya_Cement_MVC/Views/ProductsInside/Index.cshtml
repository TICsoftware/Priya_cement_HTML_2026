@{
    ViewData["Title"] = "Products Inside";
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/products-inside-style.css" />
}

    <!-- HERO BANNER END-->
   <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="overflow-hidden h-[75vh] sm:h-131.25 relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="~/Assets/images/banners/productsinside-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:992px)"
                     srcset="~/Assets/images/banners/productsinside-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="~/Assets/images/banners/productsinside-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="innerbanner-overlay"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                  <div class="container">
                     <div class="max-w-5xl text-left">

                        <h1 class="innerbanner-title text-h1 text-white">
                          MAXLOAD OPC - 53 Grade
                        </h1>

                        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 Products
                              </li>
                           </ol>
                        </nav>

                     </div>
                  </div>
               </div>
           

         </div>
   </section>
    <!-- HERO BANNER END -->

    <div class="product-float-rail">
      <div class="product-float-outer product-float-sticky">
         <div class="product-float-inner" aria-hidden="true">
         <img src="~/Assets/images/products/MAXLOAD.webp" alt="" class="product-float-bag">
         <img src="~/Assets/images/products/shadow-ellipse.webp" alt="" class="product-shadow-ellipse">
         </div>
         <div class="product-site-link">
            <a href="#" class="fill-site-link">
                  <span>Get in touch</span>
                  <span class="fill-site-link-arrow" aria-hidden="true">
                     <img src="~/Assets/images/common-images/button-arrow-icon.svg" alt="">
                  </span>
               </a>
         </div>
      </div>
    </div>


    <div class="product-download-fab" data-download-fab>
      <div class="product-download-fab-actions" role="group" aria-label="Downloads">
        <a href="#" class="product-download-pill">
          <span>Product Brochure</span>
          <img src="~/Assets/images/common-images/download-vector.svg" alt="" aria-hidden="true">
        </a>
        <a href="#" class="product-download-pill">
          <span>Technical Data Sheet</span>
          <img src="~/Assets/images/common-images/download-vector.svg" alt="" aria-hidden="true">
        </a>
      </div>
      <button type="button" class="product-float-button" aria-expanded="false" aria-label="Download documents">
        <img src="~/Assets/images/common-images/download-icon.svg" alt="" class="w-auto h-auto object-cover" aria-hidden="true">
      </button>
    </div>

    <section class="relative overflow-hidden section-spacing page-intro-outer">
      <div class="container">
         <div class="intro-outer-wrapper flex-col flex gap-6 lg:gap-12 items-start">
            <div class="intro-title-col lg:max-w-5xl">
               <div class="section-title-outer section-title-outer-start section-with-intro">
                  <h2 class="text-h2 title-section reveal-text">
                     Engineered for <span>maximum strength</span>
                  </h2>
                  <p>MAXLOAD OPC — 53 Grade is a high-strength Ordinary Portland Cement engineered for structural applications, delivering reliable performance across residential, commercial, industrial, and infrastructure projects.</p>
               </div>
            </div>
         </div>

         <h3 class="mt-14 text-h4">Best for</h3>
         <div class="mt-4 border-t border-[#EAEAEA] pt-5 sm:pt-10 product-content-max">
            <div class="grid gap-y-4 gap-x-4 sm:gap-x-16 sm:gap-y-10 grid-cols-2 sm:grid-cols-2 bestfor-grid-outer">
               <div class="flex items-center flex-col sm:flex-row gap-2 sm:gap-6 bestfor-grid">
                  <img src="~/Assets/images/products/bestfor/high-rise-buildings.svg" alt="" class="h-auto w-auto object-cover shrink-0">
                  <p class="text-20 font-medium">High-rise buildings</p>
               </div>
               <div class="flex items-center flex-col sm:flex-row gap-2 sm:gap-6 bestfor-grid">
                  <img src="~/Assets/images/products/bestfor/industrial-structures.svg" alt="" class="h-auto w-auto object-cover shrink-0">
                  <p class="text-20 font-medium">Industrial structures</p>
               </div>
               <div class="flex items-center flex-col sm:flex-row gap-2 sm:gap-6 bestfor-grid">
                  <img src="~/Assets/images/products/bestfor/bridges-flyovers.svg" alt="" class="h-auto w-auto object-cover shrink-0">
                  <p class="text-20 font-medium">Bridges and flyovers</p>
               </div>
               <div class="flex items-center flex-col sm:flex-row gap-2 sm:gap-6 bestfor-grid">
                  <img src="~/Assets/images/products/bestfor/rcc-structures.svg" alt="" class="h-auto w-auto object-cover shrink-0">
                  <p class="text-20 font-medium">RCC structures</p>
               </div>
            </div>
         </div>

      </div>
    </section>

   <section class="section-spacing whyexperts-section relative overflow-hidden">
      <div class="bgimage-outer-wrap" aria-hidden="true">
         <img src="Assets/images/bg-image.webp" alt="" class="w-full h-full object-cover bg-image">
      </div>
    <div class="container">
      <h3 class="text-h4">Why experts choose MAXLOAD OPC — 53 Grade</h3>
      <div class="mt-4 grid gap-10 border-t border-[#EAEAEA] pt-6 product-content-max lg:grid-cols-2 lg:gap-x-16">

        <article class="flex gap-7 whyexperts-article">
          <span class="grid shrink-0 place-items-center bg-white shadow-tile whyexperts-icon">
           <img src="~/Assets/images/products/whyexperts/rapid-strength-gain.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div class="whyexperts-content">
            <h4 class="text-20">Rapid strength gain</h4>
            <p>MAXLOAD OPC - 53 Grade achieves significant compressive strength within the first three days of curing, allowing earlier formwork stripping and faster progression to the next stage of construction.</p>
          </div>
        </article>

        <article class="flex gap-7 whyexperts-article">
          <span class="grid shrink-0 place-items-center bg-white shadow-tile whyexperts-icon">
            <img src="~/Assets/images/products/whyexperts/built-heavy-loads.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div class="whyexperts-content">
            <h4 class="text-20">Built for heavy loads</h4>
            <p>With a 28-day compressive strength of 66 MPa, MAXLOAD OPC - 53 Grade is engineered for structures where load-bearing capacity is the primary design requirement.</p>
          </div>
        </article>

        <article class="flex gap-7 whyexperts-article">
          <span class="grid shrink-0 place-items-center bg-white shadow-tile whyexperts-icon">
            <img src="~/Assets/images/products/whyexperts/reduces-construction-time.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div class="whyexperts-content">
            <h4 class="text-20">Reduces construction time</h4>
            <p>High early strength development means project timelines can be shortened without compromising structural integrity, a critical advantage for time-bound infrastructure and commercial projects.</p>
          </div>
        </article>

        <article class="flex gap-7 whyexperts-article">
          <span class="grid shrink-0 place-items-center bg-white shadow-tile whyexperts-icon">
            <img src="~/Assets/images/products/whyexperts/consistent-across-batches.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div class="whyexperts-content">
            <h4 class="text-20">Consistent across batches</h4>
            <p>Manufactured under continuous quality monitoring and tested against Bureau of Indian Standards specifications, every batch of MAXLOAD OPC - 53 Grade delivers the same level of performance.</p>
          </div>
        </article>

        <article class="flex gap-7 whyexperts-article">
          <span class="grid shrink-0 place-items-center bg-white shadow-tile whyexperts-icon">
            <img src="~/Assets/images/products/whyexperts/proven-demanding-applications.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          </span>
          <div class="whyexperts-content">
            <h4 class="text-20">Proven in demanding applications</h4>
            <p>From high-rise buildings and industrial structures to pre-stressed concrete and infrastructure projects, MAXLOAD OPC - 53 Grade has a verified track record across the most demanding construction environments.</p>
          </div>
        </article>

        <article class="flex gap-7 whyexperts-article">
          <span class="grid shrink-0 place-items-center bg-white shadow-tile whyexperts-icon">
            <img src="~/Assets/images/products/whyexperts/manufactured-exceed.svg" alt="" class="h-auto w-auto object-cover shrink-0">
          </span>
          <div class="whyexperts-content">
            <h4 class="text-20">Manufactured to exceed, not just meet the standard</h4>
            <p>MAXLOAD's actual test results consistently exceed IS 269:2015 requirements across physical, mechanical and chemical parameters, not by a narrow margin but by a measurable one.</p>
          </div>
        </article>
      </div>
    </div>
   </section>

   <section class="section-spacing greenpro-section">
      <div class="container">
         <h3 class="text-h4">GreenPro certification</h3>
         <div class="mt-4 border-t border-[#EAEAEA] pt-6 product-content-max">
             <h4 class="text-p font-semibold mb-1">
                  GreenPro certified across its full lifecycle
               </h4>
               <p>
                  The GreenPro label serves as a mark of sustainable, low-carbon and durable construction material, demonstrating our commitment to environmental stewardship.
               </p>

            <ul class="greenpro-chips" aria-label="GreenPro certification highlights">
               <li class="greenpro-chip">Fly ash content: 15–35%</li>
               <li class="greenpro-chip">Lower carbon footprint</li>
               <li class="greenpro-chip">Independently verified</li>
            </ul>
         </div>
      </div>
   </section>

   <section class="section-spacing physicalproperties-section">
      <div class="container">
         <h3 class="text-h4">Physical properties</h3>
     
      <div class="table-scroll mt-6" data-table-scroll>
         <div class="table-scroll-x">
         <table class="spec-table">
         <thead>
               <tr class="bg-brand-row">
                  <th class="w-[30%]">Parameter</th>
                  <th class="w-[34%]">What this measures</th>
                  <th class="w-[19%]">IS 269:2015<br />requirement</th>
                  <th class="w-[17%]">Priya Cement<br />test result</th>
            </tr>
         </thead>
            <tbody>
               <tr>
                  <td>Fineness - specific surface</td>
                  <td>How finely the cement is ground. Higher fineness means better reactivity and strength development.</td>
                  <td>Min. 225 m²/kg</td>
                  <td>288 m²/kg</td>
            </tr>
            <tr>
                  <td>Initial setting time</td>
                  <td>How long the cement remains workable after mixing with water.</td>
                  <td>Min. 30 minutes</td>
                  <td>140 minutes</td>
            </tr>
            <tr>
                  <td>Final setting time</td>
                  <td>How long before the cement becomes fully rigid and cannot be disturbed.</td>
                  <td>Max. 600 minutes</td>
                  <td>220 minutes</td>
            </tr>
            <tr>
                  <td>Le Chatelier expansion</td>
                  <td>Measures soundness, whether the cement expands excessively after setting, which can cause cracking.</td>
                  <td>Max. 10.0 mm</td>
                  <td>1.0 mm</td>
            </tr>
            <tr>
                  <td>Autoclave expansion</td>
                  <td>A more stringent test of soundness under high pressure and temperature.</td>
                  <td>Max. 0.8%</td>
                  <td>0.067%</td>
            </tr>
            </tbody>
         </table>
         </div>
      </div>
     </div>
   </section>

  <section class="section-spacing compressivestrength-section relative overflow-hidden">
     <div class="bgimage-outer-wrap" aria-hidden="true">
         <img src="Assets/images/bg-image.webp" alt="" class="w-full h-full object-cover bg-image">
      </div>
      <div class="container">
         <h3 class="text-h4">Compressive strength</h3>
     
      <div class="table-scroll mt-6" data-table-scroll>
         <div class="table-scroll-x">
            <table class="spec-table spacing-table-td">
               <thead>
                  <tr class="bg-brand-row">
                     <th class="w-[30%]">Curing period</th>
                     <th class="w-[34%]">IS 269:2015 minimum</th>
                     <th class="w-[36%]">Priya Cement test result</th>
                  </tr>
               </thead>
               <tbody>
                  <tr>
                     <td>3 days</td>
                     <td>Min. 27 MPa</td>
                     <td>36 MPa</td>
                  </tr>
                  <tr>
                     <td>7 days</td>
                     <td>Min. 37 MPa</td>
                     <td>45 MPa</td>
                  </tr>
                  <tr class="bg-gradient-row">
                     <td>28 days</td>
                     <td>Min. 53 MPa</td>
                     <td>66 MPa</td>
                  </tr>
                  </tbody>
            </table>
            <div class="lion-red-wrap"><img src="~/Assets/images/common-images/lion-red.svg" alt="" class="w-auto h-auto object-cover"></div>
         </div>
      </div>
     </div>
  </section>

   <section class="section-spacing chemicalproperties-section">
      <div class="container">
         <h3 class="text-h4">Chemical properties</h3>
     
      <div class="table-scroll mt-6" data-table-scroll>
         <div class="table-scroll-x">
         <table class="spec-table">
            <thead>
               <tr class="bg-brand-row">
                  <th class="w-[30%]">Parameter</th>
                  <th class="w-[34%]">What this measures</th>
                  <th class="w-[19%]">IS 269:2015<br />requirement</th>
                  <th class="w-[17%]">Priya Cement<br />test result</th>
               </tr>
            </thead>
            <tbody>
               <tr>
                  <td>Loss on ignition</td>
                  <td>Measures impurities that do not dissolve in acid, lower values indicate higher purity.</td>
                  <td>Max. 4.0%</td>
                  <td>2.04%</td>
               </tr>
               <tr>
                  <td>Insoluble residue</td>
                  <td>Measures impurities that do not dissolve in acid, lower values indicate higher purity.</td>
                  <td>Max. 5.0%</td>
                  <td>4.04%</td>
               </tr>
               <tr>
                  <td>Sulphuric anhydride</td>
                  <td>Controls sulphate content, which affects setting time and long-term durability.</td>
                  <td>Max. 3.5%</td>
                  <td>1.77%</td>
               </tr>
               </tbody>
         </table>
         </div>
      </div>
     </div>
   </section>

   <section class="section-spacing thingstoknow-section relative overflow-hidden">
      <div class="bgimage-outer-wrap" aria-hidden="true">
         <img src="Assets/images/bg-image.webp" alt="" class="w-full h-full object-cover bg-image">
      </div>
      <div class="container">
         <h3 class="text-h4">Things to know before you order</h3>
         <div class="mt-4 grid gap-10 border-t border-surface-line pt-10 sm:grid-cols-2 product-content-max">
            <div class="flex items-center gap-6">
              <img src="~/Assets/images/products/brickwork.svg" alt="" class="h-auto w-auto object-cover shrink-0">
               <div class="max-w-[290px]">
                  <p class="text-20 font-medium">Take extra care in brickwork and plastering where low heat of hydration is required.</p>
               </div>
            </div>
            <div class="flex items-center gap-6">
              <img src="~/Assets/images/products/mass-concreting.svg" alt="" class="h-auto w-auto object-cover shrink-0">
              <div class="max-w-[290px]">
               <p class="text-20 font-medium">Use temperature control measures in mass concreting to prevent thermal cracking caused by high heat of hydration.</p>
              </div>
            </div>
         </div>
         <div class="outer-btn-wrap mt-6 sm:mt-10">
            <a class="site-link" href="#">
               Compare MAXLOAD with Portland Pozzolana Cement (PPC)
               <span class="site-link-arrow" aria-hidden="true"><img src="Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover"></span>
            </a>
         </div>
      </div>
   </section>

    <!-- CTA -->
  <section class="relative overflow-hidden bg-brand-band cta-band section-spacing">
      <div class="logo-lion-vector-outer lion-logo-wrap">

